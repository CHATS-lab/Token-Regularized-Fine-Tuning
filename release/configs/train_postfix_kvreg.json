{
  "_comment": "Example: Qwen3-8B LoRA SFT with POSTFIX KV-cache regularization. The base model's K/V at postfix positions (assistant-header tokens between the user content and the assistant response, plus optionally the empty <think>...</think> block for Qwen3) are recorded ONCE on the first real training example (causal-attention-correct context). The trainable model is penalized whenever its K/V at those positions drift away from the base.",
  "model": "qwen",
  "model_size": "8b",
  "training_file": "data/your_train_data.jsonl",
  "output_dir": "models/example_qwen3_8b_postfix_kvreg",
  "is_peft": true,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.0,
  "lora_bias": "none",
  "epochs": 1,
  "max_seq_length": 2048,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 8,
  "warmup_steps": 5,
  "learning_rate": 1e-05,
  "lr_scheduler_type": "cosine",
  "weight_decay": 0.01,
  "optim": "adamw_8bit",
  "logging_steps": 1,
  "save_steps": 1000,
  "seed": 0,
  "loss": "sft",
  "train_on_responses_only": true,
  "shuffle_train": true,
  "use_template": true,
  "use_prefix_kv_cache_regularization": false,
  "prefix_kv_regularization_weight": 1,
  "trust_drift_threshold": 0,
  "use_postfix_kv_cache_regularization": true,
  "postfix_kv_regularization_weight": 1,
  "postfix_trust_drift_threshold": 0,
  "postfix_kv_include_think_block": true,
  "always_record_unweighted_postfix_kv_reg_loss": true,
  "regularization_active_ratio": 1.0,
  "use_sys_in_training": false,
  "training_system_prompt": null,
  "strip_full_system_block": false,
  "left": 0,
  "right": 99999
}